[0m15:41:05.415515 [debug] [Thread-1 (]: On model.dbt_assignment.dim_films: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "dbt_class", "target_name": "dev", "node_id": "model.dbt_assignment.dim_films"} */

  
    

  create  table "analytics"."dev_assignment"."dim_films__dbt_tmp"
  
  
    as
  
  (
    -- CTE to join stg_film_categories and stg_categories
WITH category_cte AS (
    SELECT 
        fc.film_id
        , fc.category_id
        , c.category_name
    FROM "analytics"."dev_assignment"."stg_film_categories" fc
    LEFT JOIN "analytics"."dev_assignment"."stg_categories" c
        ON fc.category_id = c.category_id
),
film_cte AS (
    SELECT 
        f.*
        , rd.rating_description
        , cat.category_name
    FROM "analytics"."dev_assignment"."stg_films" f
    LEFT JOIN "analytics"."dev_assignment"."rating_descriptions" rd
        ON f.rating = rd.rating
    LEFT JOIN category_cte cat
        ON f.film_id = cat.film_id
)

SELECT 
    fc.film_id
    , fc.title
    , string_agg(fc.category_name, ', ') AS category
    , fc.rating
    , fc.rating_description
    , fc.rental_rate
    , COALESCE(COUNT(DISTINCT i.inventory_id),0) AS inventory_count
    , COALESCE(COUNT(DISTINCT r.rental_id),0) AS times_rented
    , CASE 
        WHEN COALESCE(COUNT(DISTINCT i.inventory_id), 0) > 0 THEN TRUE ELSE FALSE
    END AS is_available

FROM film_cte fc
LEFT JOIN "analytics"."dev_assignment"."stg_inventory" i
    ON fc.film_id = i.film_id
LEFT JOIN "analytics"."dev_assignment"."stg_rentals" r
    ON i.inventory_id = r.inventory_id
GROUP BY 1,2,4, 5
  );
  
[0m15:41:05.415941 [debug] [Thread-2 (]: Using postgres connection "model.dbt_assignment.dim_customers"
[0m15:41:05.416409 [debug] [Thread-1 (]: Opening a new connection, currently in state closed
[0m15:41:05.416960 [debug] [Thread-2 (]: On model.dbt_assignment.dim_customers: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "dbt_class", "target_name": "dev", "node_id": "model.dbt_assignment.dim_customers"} */

  
    

  create  table "analytics"."dev_assignment"."dim_customers__dbt_tmp"
  
  
    as
  
  (
    -- aggregate total rentals, first rental date, last rental date, and lifetime payment total by customer
WITH rental_agg AS (
    SELECT
        customer_id
        , COUNT(DISTINCT rental_id) AS total_rentals
        , MIN(rental_date) AS first_rented_at
        , MAX(rental_date) AS last_rented_at 
    FROM  "analytics"."dev_assignment"."stg_rentals" 
    GROUP BY 1
),

payment_agg AS (
    SELECT 
        customer_id
        , SUM(amount) AS lifetime_payment_total
    FROM "analytics"."dev_assignment"."stg_payments"
    GROUP BY 1
)

-- main query
SELECT 
    c.customer_id
    , c.first_name || ' ' || c.last_name AS customer_name
    , COALESCE(r.total_rentals, 0) AS total_rentals
    , r.first_rented_at
    , r.last_rented_at
    , COALESCE(p.lifetime_payment_total, 0) AS lifetime_payment_total
FROM "analytics"."dev_assignment"."stg_customers" c
LEFT JOIN rental_agg r
    ON c.customer_id = r.customer_id
LEFT JOIN payment_agg p
    ON c.customer_id = p.customer_id
  );
  

  create  table "analytics"."dev_assignment"."dim_customers__dbt_tmp"
  
  
    as
  
  (
    -- aggregate total rentals, first rental date, last rental date, and lifetime payment total by customer
WITH rental_agg AS (
    SELECT
        customer_id
        , COUNT(DISTINCT rental_id) AS total_rentals
        , MIN(rented_at) AS first_rented_at
        , MAX(rented_at) AS last_rented_at 
    FROM  "analytics"."dev_assignment"."stg_rentals" 
    GROUP BY 1
),

payment_agg AS (
    SELECT 
        customer_id
        , SUM(amount) AS lifetime_payment_total
    FROM "analytics"."dev_assignment"."stg_payments"
    GROUP BY 1
)

-- main query
SELECT 
    c.customer_id
    , c.first_name || ' ' || c.last_name AS customer_name
    , COALESCE(r.total_rentals, 0) AS total_rentals
    , r.first_rented_at
    , r.last_rented_at
    , COALESCE(p.lifetime_payment_total, 0) AS lifetime_payment_total
FROM "analytics"."dev_assignment"."stg_customers" c
LEFT JOIN rental_agg r
    ON c.customer_id = r.customer_id
LEFT JOIN payment_agg p
    ON c.customer_id = p.customer_id
  );
  
[0m15:54:10.233227 [debug] [Thread-1 (]: On model.dbt_assignment.fact_payments: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "dbt_class", "target_name": "dev", "node_id": "model.dbt_assignment.fact_payments"} */

  
    

  create  table "analytics"."dev_assignment"."fact_payments__dbt_tmp"
  
  
    as
  
  (
    -- since stg_rentals doesn't have film_id, join stg_rentals with stg_inventory and stg_films
WITH join_cte AS (
    SELECT 
        r.rental_id
        , r.inventory_id
        , i.film_id
        , i.store_id
        , f.title
    FROM "analytics"."dev_assignment"."stg_rentals" r
    LEFT JOIN "analytics"."dev_assignment"."stg_inventory" i
        ON r.inventory_id = i.inventory_id
    LEFT JOIN "analytics"."dev_assignment"."stg_films" f
        ON i.film_id = f.film_id
)

SELECT 
    p.payment_id
    , p.paid_at
    , p.paid_at::DATE AS paid_date
    , c.customer_id
    , c.first_name || ' ' || c.last_name AS customer_name
    , p.staff_id
    , j.store_id
    , p.rental_id
    , j.film_id
    , j.title AS film_title
    , p.amount
FROM "analytics"."dev_assignment"."stg_payments" p
LEFT JOIN "analytics"."dev_assignment"."stg_customers" c
    ON p.customer_id = c.customer_id
LEFT JOIN join_cte j
    ON p.rental_id = j.rental_id
  );
  
